# ============================================================
# Production Dockerfile for Revive Backend
# Optimized multi-stage build for Spring Boot 3.2.5
# Java 17 | Maven | Production-Ready | Minimal Image Size
# ============================================================

# Stage 1: Build Stage (Maven build with JDK)
FROM maven:3.9-eclipse-temurin-17-alpine AS builder

WORKDIR /build

# Copy pom.xml for dependency caching
COPY pom.xml .

# Download dependencies (cached layer)
RUN mvn dependency:go-offline -B -q

# Copy source code
COPY src ./src

# Build the application (skip tests for production)
RUN mvn clean package -B -q -DskipTests && \
    # Extract the built JAR name for easier copying
    mv target/revive-backend-*.jar target/app.jar

# ============================================================
# Stage 2: Runtime Stage (minimal JRE image + Python for ML)
FROM eclipse-temurin:17-jre

# Install curl and Python for health checks and ML predictions
RUN apt-get update && \
    apt-get install -y curl python3 python3-pip python3-venv && \
    rm -rf /var/lib/apt/lists/*

# Install Python ML dependencies (bypass PEP 668 for Docker container)
RUN pip3 install --no-cache-dir --break-system-packages \
    scikit-learn==1.3.0 \
    pandas==2.0.3 \
    numpy==1.24.3 \
    joblib==1.3.2

WORKDIR /app

# Create non-root user for security
RUN useradd -m -u 1001 appuser && \
    chown -R appuser:appuser /app

# Copy built JAR from builder stage
COPY --from=builder --chown=appuser:appuser /build/target/app.jar app.jar

# Copy ML model and prediction script (critical for recovery predictions)
COPY --chown=appuser:appuser ml /app/ml

# Switch to non-root user
USER appuser

# Expose port (Render will override with PORT env var)
EXPOSE 8080

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8080}/healthz || exit 1

# JVM optimization flags for production (512MB RAM constraint)
ENV JAVA_OPTS="-Xmx350m \
    -Xms128m \
    -XX:+UseG1GC \
    -XX:MaxGCPauseMillis=100 \
    -XX:+UseStringDeduplication \
    -XX:+OptimizeStringConcat \
    -Djava.security.egd=file:/dev/./urandom \
    -Dspring.jmx.enabled=false"

# Run the application with dynamic port support
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar --server.port=${PORT:-8080}"]
