# ------------------------------------------------------------------------------
# 1. SECURITY & SECRETS 🔐 (CRITICAL: NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
!.env.template
!**/.env.template
.env.backup
.env.save
.envrc
.envrc.*

